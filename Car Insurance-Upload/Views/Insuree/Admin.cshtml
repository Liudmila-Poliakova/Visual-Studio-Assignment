@* Views/Insuree/Admin.cshtml *@
@* Author: Liudmila Poliakova *@
@* Requirement 3: Admin view showing all quotes with first name, last name and email *@

@model IEnumerable<CarInsurance.Models.Insuree>

@{
    ViewData["Title"] = "Admin - All Quotes";
}

<h2>Admin — All Quotes Issued</h2>
<p class="text-muted">This page is for site administrators only. It shows all quotes issued along with customer information.</p>
<hr />

@if (!Model.Any())
{
    @* Show a message if no quotes have been issued yet *@
    <p>No quotes have been issued yet.</p>
}
else
{
    <table class="table table-bordered table-hover">
        <thead class="thead-dark">
            <tr>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Email Address</th>
                <th>Monthly Quote</th>
            </tr>
        </thead>
        <tbody>
            @* Loop through each insuree and display their name, email, and quote *@
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.FirstName</td>
                    <td>@item.LastName</td>
                    <td>@item.EmailAddress</td>
                    @* Format the quote as a dollar amount *@
                    <td>@item.Quote.ToString("C")</td>
                </tr>
            }
        </tbody>
    </table>
}

<div>
    @* Link back to the main insuree list *@
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
